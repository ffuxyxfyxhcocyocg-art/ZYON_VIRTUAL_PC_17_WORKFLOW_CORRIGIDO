<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZyonVirtualPC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryVariant">#00B8D4</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#7C4DFF</item>
        <item name="android:statusBarColor">#0A0E17</item>
        <item name="android:navigationBarColor">#0A0E17</item>
        <item name="android:windowBackground">#0A0E17</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0BEC5</item>
        <item name="materialButtonStyle">@style/Widget.Zyon.Button</item>
    </style>
    <style name="Widget.Zyon.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#00E5FF</item>
        <item name="android:textColor">#000000</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="Theme.ZyonVirtualPC.Fullscreen" parent="Theme.ZyonVirtualPC">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
