<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Editor de Hardware" android:textSize="18sp" android:textStyle="bold" />

        <EditText android:id="@+id/et_hw_cores" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Núcleos CPU" android:inputType="number"
            android:text="2" android:layout_marginTop="8dp" />

        <EditText android:id="@+id/et_hw_ram" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="RAM MB (max 16384)" android:inputType="number"
            android:text="2048" android:layout_marginTop="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GPU" android:layout_marginTop="12dp" />
        <Spinner android:id="@+id/sp_gpu" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Rede" android:layout_marginTop="12dp" />
        <Spinner android:id="@+id/sp_nic" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Áudio" android:layout_marginTop="12dp" />
        <Spinner android:id="@+id/sp_audio" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <Button android:id="@+id/btn_hw_save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Salvar" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
