<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0A0E17">

    <TextView
        android:id="@+id/version_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZYON VIRTUAL PC 17"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:letterSpacing="0.08"
        android:paddingBottom="4dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MASTER ULTIMATE  ·  ARM64  ·  QEMU"
        android:textSize="11sp"
        android:textColor="#80CBC4"
        android:paddingBottom="16dp"/>

    <Button android:id="@+id/btn_create_vm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="🖥️  Nova máquina virtual" />
    <Button android:id="@+id/btn_host_apps" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="🎮  Apps do celular → PC virtual" />
    <Button android:id="@+id/btn_disks" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="💾  Discos / ISO" />
    <Button android:id="@+id/btn_snaps" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📸  Snapshots" />
    <Button android:id="@+id/btn_perf" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="⚡  Desempenho" />
    <Button android:id="@+id/btn_logs" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📋  Logs" />
    <Button android:id="@+id/btn_settings" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="⚙️  Configurações" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MÁQUINAS VIRTUAIS" android:textColor="#546E7A" android:textSize="11sp"
        android:layout_marginTop="16dp" android:letterSpacing="0.12"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vm_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />
</LinearLayout>
