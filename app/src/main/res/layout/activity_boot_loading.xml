<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp"
    android:background="#020617">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🖥"
        android:textSize="64sp"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZYON VIRTUAL PC 17"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#4A90D9"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Master Ultimate"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="40dp"/>

    <ProgressBar
        android:id="@+id/progress_boot"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"/>

    <TextView
        android:id="@+id/tv_boot_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciando…"
        android:textColor="#E2E8F0"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_boot_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#64748B"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

</LinearLayout>
